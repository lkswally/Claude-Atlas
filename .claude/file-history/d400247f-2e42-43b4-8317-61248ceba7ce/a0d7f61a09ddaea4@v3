                "period": period,
                "message": "Base de datos Finance MVP no inicializada. Ejecutá bootstrap_finance_mvp.py primero.",
                "total_egresos": None,
                "total_ingresos": None,
                "balance": None,
            }

        egresos_res = list_records("egreso", {"period": period}, db_path=db_path)
        ingresos_res = list_records("ingreso", {"period": period}, db_path=db_path)
        pendientes_res = list_period_pending_items(period, db_path=db_path)

        egresos_list = []
        ingresos_list = []

        eg_data = egresos_res.get("data") if isinstance(egresos_res, dict) else {}
        if isinstance(eg_data, dict):
            egresos_list = eg_data.get("records") or eg_data.get("items") or []
        elif isinstance(eg_data, list):
            egresos_list = eg_data

        ing_data = ingresos_res.get("data") if isinstance(ingresos_res, dict) else {}
        if isinstance(ing_data, dict):
            ingresos_list = ing_data.get("records") or ing_data.get("items") or []
        elif isinstance(ing_data, list):
            ingresos_list = ing_data

        total_egresos = sum(
            float(r.get("monto") or 0) for r in egresos_list if isinstance(r, dict)
        )
        total_ingresos = sum(
            float(r.get("monto") or 0) for r in ingresos_list if isinstance(r, dict)
        )

        pend_data = pendientes_res.get("data") if isinstance(pendientes_res, dict) else {}
        borradores = []
        if isinstance(pend_data, dict):
            borradores = pend_data.get("borradores") or pend_data.get("pendientes") or []

        top_egresos = sorted(egresos_list, key=lambda x: float(x.get("monto") or 0), reverse=True)[:5]

        return {
            "ok": True,
            "period": period,
            "total_egresos": total_egresos,
            "total_ingresos": total_ingresos,
            "balance": total_ingresos - total_egresos,
            "count_egresos": len(egresos_list),
            "count_ingresos": len(ingresos_list),
            "borradores_pendientes": len(borradores),
            "top_egresos": [
                {
                    "proveedor": r.get("proveedor_nombre") or r.get("detalle", "—"),
                    "monto": float(r.get("monto") or 0),
                    "categoria": r.get("categoria_financiera_code") or "—",
                }
                for r in top_egresos if isinstance(r, dict)
            ],
        }

    except ImportError:
        # Fallback: orchestrator CFO (Google Sheets)
        import asyncio
        loop = asyncio.new_event_loop()
        try:
            from agents.orchestrator import _run_cfo
            data = loop.run_until_complete(_run_cfo("gastos del mes"))
        except Exception as e:
            data = {"ok": False, "error": str(e)}
        finally:
            loop.close()
        return {"ok": data.get("ok", False), "period": period, "source": "google_sheets", **data}


