def build_server(host="0.0.0.0", port=8700):
    return HTTPServer((host, port), Handler)


def main():
    host = os.getenv("REYESOFT_DASHBOARD_HOST", "0.0.0.0")
    port = int(os.getenv("REYESOFT_DASHBOARD_PORT", "8700"))
    srv = build_server(host, port)
    print(f"Reyesoft OS  ·  Dashboard 360°")
    print(f"Local:  http://localhost:{port}")
    print(f"Red:    http://0.0.0.0:{port}")
    print("Ctrl+C para apagar\n")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("Apagando…")
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
