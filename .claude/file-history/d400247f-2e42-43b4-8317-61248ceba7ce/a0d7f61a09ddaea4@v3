def _api_cx_upload(file_bytes: bytes, filename: str) -> dict:
    import hashlib
    dest_dir = ROOT / "data" / "cx_auditor"
    dest_dir.mkdir(parents=True, exist_ok=True)
    safe_name = Path(filename).name
    dest = dest_dir / safe_name
    dest.write_bytes(file_bytes)
    try:
        from cx_auditor.pipeline.parser import process_csv
        result = process_csv(dest, init_schema=True)
        return {
            "ok": True,
            "filename": safe_name,
            "saved_to": str(dest),
            "import_job_id": result.get("import_job_id"),
            "total_rows": result.get("total_rows_detected"),
            "valid_rows": result.get("valid_rows"),
            "excluded": result.get("excluded_rows"),
            "duplicated": result.get("duplicated_rows"),
            "missing_fields": result.get("missing_required_fields", []),
        }
    except Exception as e:
        return {"ok": False, "filename": safe_name, "error": str(e)}


def _api_knowledge(query: str) -> dict:
    if not query.strip():
        return {"query": "", "results": []}
    try:
        from tools.knowledge_rag import retrieve, extract_best_paragraph
        docs = retrieve(query, top_k=4)
        results = []
        for d in docs:
            snippet = extract_best_paragraph(d, query)
            results.append({"name": d.name, "path": d.rel_path, "snippet": snippet})
        return {"query": query, "results": results}
    except Exception as e:
        return {"query": query, "results": [], "error": str(e)}


def _parse_multipart_file(body: bytes, content_type: str):
    """Parse multipart/form-data body; returns (file_bytes, filename) or (None, None)."""
    boundary_match = re.search(r"boundary=([^\s;]+)", content_type)
    if not boundary_match:
        return None, None
    boundary = boundary_match.group(1).strip('"')
    # Build a fake email message to leverage email parser
    msg_bytes = f"Content-Type: {content_type}\r\n\r\n".encode() + body
    try:
        msg = message_from_bytes(msg_bytes, policy=HTTP)
    except Exception:
        msg = message_from_bytes(msg_bytes)
    for part in msg.get_payload():
        if not hasattr(part, "get_param"):
            continue
        disp = part.get("Content-Disposition", "")
        name = re.search(r'name="([^"]+)"', disp)
        if name and name.group(1) == "file":
            fname_match = re.search(r'filename="([^"]*)"', disp)
            filename = fname_match.group(1) if fname_match else "upload.csv"
            payload = part.get_payload(decode=True)
            return payload, filename or "upload.csv"
    return None, None


