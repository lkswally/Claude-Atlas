# HTTP HANDLER
# ──────────────────────────────────────────────────────────────────────────────

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _json(self, data, status=200):
        body = json.dumps(data, ensure_ascii=False, default=str).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()
        self.wfile.write(body)

    def _html(self, body: bytes, status=200):
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self):
        p = urlparse(self.path)
        path = p.path.rstrip("/") or "/"
        qs = parse_qs(p.query)
        g = lambda k, d="": qs.get(k, [d])[0]

        if path in ("/", "/index.html"):
            try:
                self._html(HTML_FILE.read_bytes())
            except FileNotFoundError:
                self._html(b"<h1>index.html not found</h1>", 404)
            return

        routes = {
            "/api/people/summary":    lambda: _safe(_api_people_summary),
            "/api/people/vacaciones": lambda: _safe(_api_people_vacaciones),
            "/api/people/cumpleanos": lambda: _safe(lambda: _api_people_cumpleanos(int(g("days", "30")))),
            "/api/people/licencias":  lambda: _safe(_api_people_licencias),
            "/api/onboarding":        lambda: _safe(lambda: _api_onboarding(g("nombre"))),
            "/api/tasks":             lambda: _safe(_api_tasks),
            "/api/finance":           lambda: _safe(lambda: _api_finance_summary(g("period") or None)),
            "/api/cx":                lambda: _safe(_api_cx_metrics),
            "/api/knowledge":         lambda: _safe(lambda: _api_knowledge(g("q"))),
        }

        handler = routes.get(path)
        if handler:
            self._json(handler())
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        p = urlparse(self.path)
        path = p.path

        if path == "/api/cx/upload":
            ct = self.headers.get("Content-Type", "")
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length)
            try:
                file_bytes, filename = _parse_multipart_file(body, ct)
                if file_bytes is None:
                    self._json({"ok": False, "error": "No se encontró el campo 'file'"}, 400)
                else:
                    result = _safe(lambda: _api_cx_upload(file_bytes, filename))
                    self._json(result)
            except Exception as e:
                self._json({"ok": False, "error": str(e)}, 500)
        else:
            self._json({"error": "not found"}, 404)


