        if isinstance(licencias, list) and licencias:
            for lic in licencias:
                if isinstance(lic, dict):
                    results.append({
                        "nombre": leg.get("nombre", ""),
                        "tipo": lic.get("tipo", "Sin tipo"),
                        "desde": lic.get("desde", ""),
                        "hasta": lic.get("hasta", ""),
                        "estado": lic.get("estado", ""),
                        "motivo": lic.get("motivo", ""),
                    })
        ausentismo = leg.get("ausentismo_dias_anio", 0)
        if ausentismo and int(ausentismo) > 0:
            results.append({
                "nombre": leg.get("nombre", ""),
                "tipo": "ausentismo",
                "desde": leg.get("ausentismo_ultima_fecha", ""),
                "hasta": "",
                "estado": "registrado",
                "motivo": leg.get("ausentismo_ultimo_motivo", ""),
            })
    return results
