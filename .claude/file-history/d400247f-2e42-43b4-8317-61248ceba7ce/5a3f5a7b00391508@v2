def _parse_legajo(path: str) -> dict[str, Any] | None:
    try:
        with open(path, encoding="utf-8") as f:
            content = f.read()
        # Extract YAML frontmatter
        if content.startswith("---"):
            parts = content.split("---", 2)
            if len(parts) >= 3:
                data = yaml.safe_load(parts[1]) or {}
                return data
        return None
    except Exception:
        return None


def _all_legajos() -> list[dict[str, Any]]:
    results = []
    for path in glob.glob(os.path.join(LEGAJOS_DIR, "*.md")):
        data = _parse_legajo(path)
        if data and data.get("nombre"):
            data["_file"] = os.path.basename(path)
            results.append(data)
    return results


def _parse_date(value: Any) -> date | None:
    if not value:
        return None
    s = str(value).strip()
    for fmt in ("%Y-%m-%d", "%d/%m/%Y", "%d-%m-%Y"):
        try:
            return datetime.strptime(s, fmt).date()
        except ValueError:
            continue
    return None


def get_birthdays_next_days(days: int = 30) -> list[dict[str, Any]]:
    today = date.today()
    results = []
    for leg in _all_legajos():
        nacimiento = _parse_date(leg.get("fecha_nacimiento"))
        if not nacimiento:
            continue
        # Next birthday this year or next
        try:
            birthday_this_year = nacimiento.replace(year=today.year)
        except ValueError:
            birthday_this_year = nacimiento.replace(year=today.year, day=28)
        if birthday_this_year < today:
            try:
                birthday_next = nacimiento.replace(year=today.year + 1)
            except ValueError:
                birthday_next = nacimiento.replace(year=today.year + 1, day=28)
        else:
            birthday_next = birthday_this_year

        delta = (birthday_next - today).days
        if 0 <= delta <= days:
            results.append({
                "nombre": leg.get("nombre", ""),
                "area": leg.get("area", ""),
                "fecha_nacimiento": str(nacimiento),
                "proximo_cumple": str(birthday_next),
                "dias_para_cumple": delta,
                "edad": today.year - nacimiento.year - (
                    (today.month, today.day) < (nacimiento.month, nacimiento.day)
                ),
            })
    results.sort(key=lambda x: x["dias_para_cumple"])
    return results


def get_vacation_status_all() -> list[dict[str, Any]]:
    results = []
    for leg in _all_legajos():
        saldo = leg.get("vacaciones_saldo")
        tomadas = leg.get("vacaciones_tomadas", 0)
        disponibles = leg.get("vacaciones_disponibles", 0)
        dias_ley = leg.get("vacaciones_dias_ley", 14)
        estado = leg.get("vacaciones_estado", "normal")
        acumuladas = leg.get("vacaciones_acumuladas", 0)

        try:
            saldo_f = float(saldo) if saldo is not None else 0.0
        except (TypeError, ValueError):
            saldo_f = 0.0

        results.append({
            "nombre": leg.get("nombre", ""),
            "area": leg.get("area", ""),
            "puesto": leg.get("puesto", ""),
            "vacaciones_saldo": saldo_f,
            "vacaciones_tomadas": tomadas,
            "vacaciones_disponibles": disponibles,
            "vacaciones_dias_ley": dias_ley,
            "vacaciones_acumuladas": acumuladas,
            "vacaciones_estado": estado,
            "alerta": _vacation_alert(saldo_f, acumuladas, dias_ley),
        })
    results.sort(key=lambda x: x["vacaciones_saldo"])
    return results


def _vacation_alert(saldo: float, acumuladas: float, dias_ley: float) -> str:
    try:
        saldo_f = float(saldo)
        acum_f = float(acumuladas)
        ley_f = float(dias_ley) if dias_ley else 14.0
    except (TypeError, ValueError):
        return "sin_dato"

    if saldo_f < 0:
        return "deuda"
    if acum_f >= ley_f * 1.5:
        return "burnout_riesgo"
    if acum_f >= ley_f * 0.8:
        return "acumuladas_altas"
    return "normal"


def get_burnout_risks() -> list[dict[str, Any]]:
    results = []
    for v in get_vacation_status_all():
        if v["alerta"] in ("burnout_riesgo", "acumuladas_altas"):
            results.append(v)
    return results


def get_vacation_debtors() -> list[dict[str, Any]]:
    results = []
    for v in get_vacation_status_all():
        if v["alerta"] == "deuda" or v["vacaciones_saldo"] < 0:
            results.append(v)
    return results


def get_team_summary() -> dict[str, Any]:
    legajos = _all_legajos()
    total = len(legajos)
    areas: dict[str, int] = {}
    for leg in legajos:
        area = str(leg.get("area") or "Sin área").strip()
        areas[area] = areas.get(area, 0) + 1

    vac_status = get_vacation_status_all()
    deudores = [v for v in vac_status if v["alerta"] == "deuda"]
    burnout = [v for v in vac_status if v["alerta"] in ("burnout_riesgo", "acumuladas_altas")]

    cumples_hoy = get_birthdays_next_days(days=0)
    cumples_semana = get_birthdays_next_days(days=7)

    return {
        "total_colaboradores": total,
        "areas": areas,
        "deudores_vacaciones": len(deudores),
        "riesgo_burnout": len(burnout),
        "cumples_hoy": len(cumples_hoy),
        "cumples_proxima_semana": len(cumples_semana),
        "alertas": _build_alerts(deudores, burnout, cumples_hoy),
    }


def _build_alerts(deudores, burnout, cumples_hoy) -> list[dict[str, str]]:
    alerts = []
    for d in deudores:
        alerts.append({
            "tipo": "danger",
            "mensaje": f"{d['nombre']} adeuda {abs(d['vacaciones_saldo']):.1f} días de vacaciones",
        })
    for b in burnout:
        alerts.append({
            "tipo": "warning",
            "mensaje": f"{b['nombre']} acumuló {b['vacaciones_acumuladas']} días — riesgo burnout",
        })
    for c in cumples_hoy:
        alerts.append({
            "tipo": "info",
            "mensaje": f"Hoy es el cumpleaños de {c['nombre']}",
        })
    return alerts


