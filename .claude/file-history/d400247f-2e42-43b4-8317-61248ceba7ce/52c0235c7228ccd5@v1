    print(Fore.CYAN + "\nMENU PRINCIPAL")
    print(Fore.WHITE + "1) Resumen Ejecutivo")
    print(Fore.WHITE + "2) People")
    print(Fore.WHITE + "3) Finanzas")
    print(Fore.WHITE + "4) Ops")
    print(Fore.WHITE + "5) Legal")
    print(Fore.WHITE + "6) Sistema")
