    print(Fore.WHITE + " REYESOFT OS v18.2 | Asistente Empresarial | Modo Seguro")
    print(Fore.WHITE + f" Legajos detectados: {db_stats['stats']['total']}")
    print(Fore.CYAN + "=" * 70 + "\n")
    print(Fore.WHITE + "Comandos rapidos: escribi el numero o el comando.")
    print(Fore.WHITE + "Areas: Legal | People | Ops | Estrategia | Conocimiento")
    print(Fore.WHITE + "Modo seguro: no escribe en Obsidian sin confirmacion.\n")


