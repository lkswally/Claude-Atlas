    print(Fore.CYAN + "\nSUBMENU PEOPLE")
    print(Fore.WHITE + "1) Dashboard People")
    print(Fore.WHITE + "2) Sincronizar Altas (Tally)")
    print(Fore.WHITE + "0) Volver\n")


def _fin_menu():
    print(Fore.CYAN + "\nSUBMENU FINANZAS")
    print(Fore.WHITE + "1) Dashboard CFO")
    print(Fore.WHITE + "0) Volver\n")


def _ops_menu():
    print(Fore.CYAN + "\nSUBMENU OPS")
    print(Fore.WHITE + "1) Procesos operativos")
    print(Fore.WHITE + "0) Volver\n")


def _legal_menu():
    print(Fore.CYAN + "\nSUBMENU LEGAL")
    print(Fore.WHITE + "1) Catálogo empresa (políticas)")
    print(Fore.WHITE + "0) Volver\n")


def _sys_menu():
    print(Fore.CYAN + "\nSUBMENU SISTEMA")
    print(Fore.WHITE + "1) Diagnóstico técnico")
    print(Fore.WHITE + "2) Auditoría docs")
    print(Fore.WHITE + "0) Volver\n")


def _pause():
    try:
        input(Fore.CYAN + "\n[Enter] para volver al menu...")
    except Exception:
        pass


def main():
    db_stats = inicializar_sistema()
    os.system("cls" if os.name == "nt" else "clear")
    _banner(db_stats)
    _menu()

    interacciones = 0
    tarea = ""
    while True:
        try:
            tarea = input(Fore.GREEN + "Lucas" + Fore.WHITE + " > ")
            if tarea.lower() in ["menu", "opciones"]:
                _menu()
                continue
            if tarea.lower() in ["salir", "exit", "0"]:
                break
            if not tarea.strip():
                continue

            if tarea.strip() == "1":
                tarea = "dashboard empresa"
            elif tarea.strip() == "2":
                _people_menu()
                sub = input(Fore.GREEN + "People" + Fore.WHITE + " > ").strip()
                if sub == "1":
                    tarea = "dashboard people"
                elif sub == "2":
                    tarea = "sincronizar altas"
                else:
                    _menu()
                    continue
            elif tarea.strip() == "3":
                _fin_menu()
                sub = input(Fore.GREEN + "Finanzas" + Fore.WHITE + " > ").strip()
                if sub == "1":
                    tarea = "dashboard cfo"
                else:
                    _menu()
                    continue
            elif tarea.strip() == "4":
                _ops_menu()
                sub = input(Fore.GREEN + "Ops" + Fore.WHITE + " > ").strip()
                if sub == "1":
                    tarea = "listado de procesos"
                else:
                    _menu()
                    continue
            elif tarea.strip() == "5":
                _legal_menu()
                sub = input(Fore.GREEN + "Legal" + Fore.WHITE + " > ").strip()
                if sub == "1":
                    tarea = "catalogo empresa"
                else:
                    _menu()
                    continue
            elif tarea.strip() == "6":
                _sys_menu()
                sub = input(Fore.GREEN + "Sistema" + Fore.WHITE + " > ").strip()
                if sub == "1":
                    tarea = "diagnostico tecnico"
                elif sub == "2":
                    tarea = "auditoria docs"
                else:
                    _menu()
                    continue

            if tarea == "simular pixel":
                msg = simulate_activity("people")
                print(Fore.CYAN + msg)
                registrar_interaccion(tarea, msg)
                _pause()
                _menu()
                continue

            respuesta = ejecutar_agente(tarea, {"nombre": "Lucas", "can_color": True}, client)
            registrar_interaccion(tarea, respuesta)
            interacciones += 1
            _pause()
            _menu()

        except KeyboardInterrupt:
            break
        except Exception as e:
            error_msg = f"Error critico: {e}"
            print(Fore.RED + error_msg)
            registrar_interaccion(tarea, error_msg)


if __name__ == "__main__":
    main()
    mem_session_summary_local(
        goal="Sesion CLI de Reyesoft OS",
        accomplished=["Interacciones registradas en logs y memoria local"],
        next_steps=["Revisar logs si hubo errores"],
        discoveries=[],
        instructions=None,
        files=["logs/interacciones_YYYYMMDD.jsonl", "memory/engram.jsonl"],
    )
    print(Fore.YELLOW + "\nSesion finalizada. Estado limpiado.")
