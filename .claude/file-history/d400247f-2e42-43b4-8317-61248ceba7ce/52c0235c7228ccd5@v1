import sys
import os
import io
from colorama import init, Fore
from dotenv import load_dotenv
from core.router import ejecutar_agente
from core.bootstrap import inicializar_sistema
from core.llm_provider import get_llm_client
import atexit
import json
from datetime import datetime
from utils.redactor import redactar_pii, should_redact
from tools.pixel_bridge import log_turn
from tools.pixel_bridge import simulate_activity
from tools.memory_log import mem_save_local, mem_session_summary_local

init(autoreset=True)
load_dotenv()
client = get_llm_client()

# Forzar salida UTF-8 en consola para evitar caracteres corruptos
try:
    if hasattr(sys.stdout, "buffer"):
        sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
except Exception:
    pass

LOG_DIR = "logs"
os.makedirs(LOG_DIR, exist_ok=True)
LOG_FILE = os.path.join(LOG_DIR, f"interacciones_{datetime.now().strftime('%Y%m%d')}.jsonl")


def limpiar_estado_nda():
    """Elimina el archivo temporal del NDA al salir"""
    nda_path = os.path.join("data", "temp_nda.json")
    if os.path.exists(nda_path):
        try:
            os.remove(nda_path)
            print(Fore.YELLOW + "\nLimpiando NDA pendiente...")
        except Exception:
            pass


def registrar_interaccion(pregunta, respuesta, agente=None):
    """Guarda cada interaccion en un archivo de log"""
    try:
        if should_redact():
            pregunta = redactar_pii(pregunta)
            respuesta = redactar_pii(respuesta)
        registro = {
            "timestamp": datetime.now().isoformat(),
            "pregunta": pregunta,
            "respuesta": respuesta,
            "agente": agente,
        }
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(json.dumps(registro, ensure_ascii=False) + "\n")

        mem_save_local(
            title="Interaccion usuario",
            mem_type="learning",
            content=(
                f"**What**: {pregunta}\n"
                f"**Why**: Consulta del usuario\n"
                f"**Where**: CLI\n"
                f"**Learned**: {str(respuesta)[:200]}"
            ),
            topic_key="reyesoft-os/interacciones",
        )
        # Pixel Bridge (visualizacion)
        log_turn(pregunta, respuesta)
    except Exception:
        pass


atexit.register(limpiar_estado_nda)


