# Legacy controlado: router CLI amplio preservado por compatibilidad, no como surface ejecutiva canónica.


def _safe_console_print(text):
    clean_text = strip_ansi(str(text or ""))
    try:
        print(clean_text)
    except UnicodeEncodeError:
        encoding = getattr(sys.stdout, "encoding", None) or "utf-8"
        safe_text = clean_text.encode(encoding, errors="replace").decode(encoding, errors="replace")
        print(safe_text)


def detectar_intencion(texto):
    """
    Determina si el usuario quiere CONSULTAR o ACTUAR
    """
    texto_lower = texto.lower()
    
    # Palabras que indican ACCIÓN (crear, generar, hacer, dame, quiero)
    acciones = [
        "crear", "generar", "hacer", "redactar", "armar", "nuevo",
        "dame", "necesito", "quiero", "preparar", "elaborar", "redactame",
        "elaborame", "confeccionar"
    ]
    for accion in acciones:
        if accion in texto_lower:
            return "accion"
    
    # Palabras que indican CONSULTA (qué es, cómo, protocolo, ley)
    consultas = [
        "qué es", "cómo", "protocolo", "ley", "explicar",
        "decime", "contame", "cual es", "que es", "info", "información",
        "dónde", "cuándo", "por qué", "para qué"
    ]
    for consulta in consultas:
        if consulta in texto_lower:
            return "consulta"
    
    # Por defecto, asumimos consulta
    return "consulta"

def es_tema_legal(texto):
    """
    Detecta si la pregunta es sobre un tema legal
    """
    texto_lower = texto.lower()
    
    # Lista ampliada de términos legales
    terminos_legales = [
        # Términos específicos de COPREC / Defensa del Consumidor
        "coprec", "defensa del consumidor", "defensa consumidor", 
        "denuncia defensa", "consumidor", "reclamo consumidor",
        
        # Términos legales generales
        "legal", "ley", "protocolo", "oficio judicial", 
        "contrato", "confidencialidad", "nda",
        "delitos", "estafas", "terminos y condiciones",
        
        # Variantes de documentos
        "procedimiento reclamos", "protocolo denuncia"
    ]
    
    for termino in terminos_legales:
        if termino in texto_lower:
            return True
    
    return False

