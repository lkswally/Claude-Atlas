def _api_cx_metrics():
    try:
        from cx_auditor.db import resolve_db_path
        from cx_auditor.api import get_summary, get_quality
        db_path = resolve_db_path(None)
        summary = get_summary(db_path=db_path)
        quality = get_quality(db_path=db_path)
        return {
            "summary": summary,
            "quality": quality,
            "db_path": db_path,
        }
    except Exception as e:
