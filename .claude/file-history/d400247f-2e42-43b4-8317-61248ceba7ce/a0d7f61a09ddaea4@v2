def _api_knowledge_query(query: str):
    try:
        from tools.knowledge_rag import retrieve, extract_best_paragraph
        docs = retrieve(query, top_k=3)
        results = []
        for d in docs:
            snippet = extract_best_paragraph(d, query)
            results.append({
                "nombre": d.name,
                "ruta": d.rel_path,
                "snippet": snippet,
            })
        return {"query": query, "resultados": results}
    except Exception as e:
        return {"query": query, "resultados": [], "error": str(e)}


def _api_cfo_summary():
    try:
        import asyncio
        from agents.orchestrator import _run_cfo
        loop = asyncio.new_event_loop()
        data = loop.run_until_complete(_run_cfo("gastos del mes"))
        loop.close()
        return data
    except Exception as e:
        return {"error": str(e), "ok": False}


class DashboardHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass  # silence default access log

    def _send_json(self, data, status=200):
        body = _json_response(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def _send_html(self, content: bytes, status=200):
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(content)))
        self.end_headers()
        self.wfile.write(content)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path.rstrip("/") or "/"
        qs = parse_qs(parsed.query)

        if path == "/" or path == "/index.html":
            try:
                with open(HTML_PATH, "rb") as f:
                    self._send_html(f.read())
            except FileNotFoundError:
                self._send_html(b"<h1>Dashboard HTML not found</h1>", 404)
            return

        if path == "/api/people/summary":
            self._send_json(_api_people_summary())
        elif path == "/api/people/vacaciones":
            self._send_json(_api_people_vacaciones())
        elif path == "/api/people/cumpleanos":
            days = int(qs.get("days", ["30"])[0])
            self._send_json(_api_people_cumpleanos(days))
        elif path == "/api/people/burnout":
            self._send_json(_api_people_burnout())
        elif path == "/api/people/deudores":
            self._send_json(_api_people_deudores())
        elif path == "/api/people/licencias":
            self._send_json(_api_people_licencias())
        elif path == "/api/onboarding":
            nombre = qs.get("nombre", ["Nuevo Colaborador"])[0]
            self._send_json(_api_onboarding_checklist(nombre))
        elif path == "/api/tasks":
            self._send_json(_api_tasks())
        elif path == "/api/cx":
            self._send_json(_api_cx_metrics())
        elif path == "/api/knowledge":
            query = qs.get("q", [""])[0]
            self._send_json(_api_knowledge_query(query))
        elif path == "/api/cfo":
            self._send_json(_api_cfo_summary())
        else:
            self._send_json({"error": "endpoint no encontrado"}, 404)

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, OPTIONS")
        self.end_headers()


def build_server(host="0.0.0.0", port=8700):
    return HTTPServer((host, port), DashboardHandler)


def main():
    host = os.getenv("REYESOFT_DASHBOARD_HOST", "0.0.0.0")
    port = int(os.getenv("REYESOFT_DASHBOARD_PORT", "8700"))
    server = build_server(host, port)
    print(f"Reyesoft OS Dashboard")
    print(f"URL: http://localhost:{port}")
    print(f"LAN: http://0.0.0.0:{port}")
    print("Ctrl+C para apagar")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nApagando dashboard...")
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
