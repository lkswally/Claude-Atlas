// FINANCE MVP
// ══════════════════════════════════════════════════════════════════════════════
function buildPeriodOptions() {
  const sel = $('fin-period');
  const now = new Date();
  sel.innerHTML = '';
  for (let i=0; i<6; i++) {
    const d = new Date(now.getFullYear(), now.getMonth()-i, 1);
    const val = d.toISOString().slice(0,7);
    const label = d.toLocaleDateString('es-AR',{month:'long',year:'numeric'});
    sel.innerHTML += `<option value="${val}">${label}</option>`;
  }
}

async function loadFinance() {
  const period = $('fin-period').value;
  try {
    const d = await api(`/api/finance?period=${period}`);
    document.getElementById('tb-sub').textContent = period;

    if (!d.ok) {
      $('fin-egresos').textContent = '—';
      $('fin-ingresos').textContent = '—';
      $('fin-balance').textContent = '—';
      $('fin-count-eg').textContent = '—';
      $('fin-count-ing').textContent = '—';
      $('fin-borradores').textContent = '—';
      $('fin-top-egresos').innerHTML = `<div style="color:var(--t3);font-size:13px;padding:12px 0">${d.message||'Sin datos'}</div>`;
      $('fin-status').innerHTML = `<div class="alert alert-warning"><span class="alert-icon">⚠️</span><span>${d.message||'Finance MVP sin datos. Ejecutá bootstrap_finance_mvp.py e importá datos.'}</span></div>`;
      setDot('dot-finance','yellow');
      $('st-finance').textContent = 'Sin datos';
      return;
    }

    $('fin-egresos').textContent = fmtARS(d.total_egresos);
    $('fin-egresos').className = 'finance-amount red';
    $('fin-ingresos').textContent = fmtARS(d.total_ingresos);
    $('fin-ingresos').className = 'finance-amount green';

    const bal = d.balance||0;
    $('fin-balance').textContent = fmtARS(bal);
    $('fin-balance').className = `finance-amount ${bal>=0?'green':'red'}`;
    $('fin-count-eg').textContent = `${d.count_egresos||0} movimientos`;
    $('fin-count-ing').textContent = `${d.count_ingresos||0} movimientos`;
    $('fin-borradores').textContent = `${d.borradores_pendientes||0} borradores pendientes`;

    const top = d.top_egresos||[];
    $('fin-top-egresos').innerHTML = !top.length
      ? `<div style="color:var(--t3);font-size:13px">Sin egresos registrados</div>`
      : top.map((eg,i) => `
          <div class="finance-row">
            <div>
              <div style="font-size:13px;font-weight:${i===0?'600':'400'}">${eg.proveedor}</div>
              <div style="font-size:11px;color:var(--t3)">${eg.categoria}</div>
            </div>
            <div style="font-family:monospace;font-weight:600;color:var(--red)">${fmtARS(eg.monto)}</div>
          </div>`).join('');

    $('fin-status').innerHTML = `
      <div class="alert alert-success"><span class="alert-icon">✅</span><span>Finance MVP conectado · Base de datos activa</span></div>
      ${d.borradores_pendientes>0?`<div class="alert alert-warning" style="margin-top:8px"><span class="alert-icon">📝</span><span>${d.borradores_pendientes} borradores sin confirmar en este período</span></div>`:''}`;

    setDot('dot-finance','green');
    $('st-finance').textContent = 'Conectado';
  } catch(e) {
    toast('Error cargando tesorería','error');
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// CX
// ══════════════════════════════════════════════════════════════════════════════
async function loadCX() {
  try {
    const d = await api('/api/cx');
    if (!d.ok || !d.summary || Object.keys(d.summary).length===0) {
      $('cx-no-data').style.display='block';
      $('cx-data-wrap').style.display='none';
      setDot('dot-cx','gray');
      $('st-cx').textContent='Sin datos';
      return;
    }
    $('cx-no-data').style.display='none';
    $('cx-data-wrap').style.display='block';

    const s = d.summary||{};
    const numKeys = Object.entries(s).filter(([k,v])=>typeof v==='number');
    $('cx-kpis').innerHTML = numKeys.slice(0,4).map(([k,v])=>
      `<div class="kpi"><div class="kpi-label">${k.replace(/_/g,' ')}</div><div class="kpi-value">${v.toFixed(1)}</div></div>`
    ).join('');

    const q = d.quality||{};
    const dims = ['claridad','empatia','resolucion','severidad','alineacion'];
    $('cx-quality-list').innerHTML = dims.map(dim => {
      const val = q[dim]??q[dim+'_avg']??null;
      if (val===null) return '';
      const pct = Math.min(100, (val/5)*100);
      const col = pct>=80?'var(--green)':pct>=60?'var(--yellow)':'var(--red)';
      return `<div style="margin-bottom:14px">
        <div style="display:flex;justify-content:space-between;margin-bottom:5px;font-size:12px">
          <span style="text-transform:capitalize">${dim}</span>
          <span style="font-weight:600;color:${col}">${parseFloat(val).toFixed(2)}</span>
        </div>
        <div class="progress"><div class="progress-fill" style="width:${pct}%;background:${col}"></div></div>
      </div>`;
    }).join('');

    const team = d.team||{};
    const ops = team.operators||team.operadores||[];
    $('cx-team-tbody').innerHTML = ops.slice(0,10).map(op=>
      `<tr>
        <td style="font-weight:500">${op.operador||op.operator_name||op.name||'—'}</td>
        <td style="text-align:right;font-family:monospace">${op.total_tickets||op.tickets||'—'}</td>
        <td style="text-align:right;font-family:monospace;color:var(--accent)">${op.score_promedio!=null?parseFloat(op.score_promedio).toFixed(2):'—'}</td>
      </tr>`).join('') || `<tr><td colspan="3" style="text-align:center;color:var(--t3)">Sin datos</td></tr>`;

    setDot('dot-cx','green');
    $('st-cx').textContent='Conectado';
  } catch(e) { toast('Error cargando CX','error'); }
}

// ══════════════════════════════════════════════════════════════════════════════
// CSV UPLOAD
// ══════════════════════════════════════════════════════════════════════════════
function handleFileSelect(event) {
  uploadCSV(event.target.files[0]);
}

function handleDrop(event) {
  event.preventDefault();
  $('drop-zone').classList.remove('drag');
  const file = event.dataTransfer.files[0];
  if (file && file.name.endsWith('.csv')) uploadCSV(file);
  else toast('Por favor seleccioná un archivo .csv','error');
}

async function uploadCSV(file) {
  if (!file) return;
  const status = $('upload-status');
  const msg = $('upload-msg');
  const result = $('upload-result');
  const prog = $('upload-prog');

  status.style.display='block';
  result.style.display='none';
  prog.style.width='10%';
  msg.textContent = `Subiendo ${file.name}…`;
  toast(`Procesando ${file.name}…`,'info');

  const fd = new FormData();
  fd.append('file', file);

  try {
    prog.style.width='40%';
    const resp = await fetch('/api/cx/upload', {method:'POST', body:fd});
    prog.style.width='80%';
    const d = await resp.json();
    prog.style.width='100%';

    if (d.ok) {
      msg.textContent = '✅ Importación completada';
      result.style.display='block';
      result.innerHTML = `
        <div class="alert alert-success" style="margin-bottom:8px">
          <span class="alert-icon">✅</span>
          <div>
            <div style="font-weight:600">CSV importado exitosamente</div>
            <div style="font-size:12px;color:var(--t2);margin-top:2px">${d.filename}</div>
          </div>
        </div>
        <div class="card" style="margin-top:0">
          <div class="grid-2">
            <div><div class="kpi-label">Filas detectadas</div><div class="kpi-value">${d.total_rows||'—'}</div></div>
            <div><div class="kpi-label">Filas válidas</div><div class="kpi-value green">${d.valid_rows||'—'}</div></div>
            <div><div class="kpi-label">Excluidas</div><div class="kpi-value yellow">${d.excluded||0}</div></div>
            <div><div class="kpi-label">Duplicadas</div><div class="kpi-value">${d.duplicated||0}</div></div>
          </div>
          ${d.missing_fields?.length?`<div class="alert alert-warning" style="margin-top:12px"><span class="alert-icon">⚠️</span><span>Campos faltantes: ${d.missing_fields.join(', ')}</span></div>`:''}
          <div style="margin-top:14px">
            <button class="btn btn-primary" onclick="goView('cx-audit');loadCX()">Ver resultados →</button>
          </div>
        </div>`;
      toast('CSV importado correctamente','success');
    } else {
      msg.textContent = '❌ Error en importación';
      result.style.display='block';
      result.innerHTML = `<div class="alert alert-danger"><span class="alert-icon">❌</span><span>${d.error||'Error desconocido'}</span></div>`;
      toast('Error al importar CSV: '+d.error,'error');
    }
  } catch(e) {
    msg.textContent = '❌ Error de conexión';
    prog.style.width='0%';
    toast('Error de conexión al importar','error');
  }
}

