async function loadOnboarding() {
  const nombre = $('ob-nombre').value.trim() || 'Nuevo Colaborador';
  try {
    const data = await api(`/api/onboarding?nombre=${encodeURIComponent(nombre)}`);
    $('ob-progress-wrap').style.display = 'block';
    $('ob-sections').innerHTML = data.categorias.map((cat,ci) => `
      <div class="card" style="margin-bottom:12px">
        <div class="checklist-cat">${cat.categoria}</div>
        ${cat.items.map((item,ii) => {
          const id = `ob_${ci}_${ii}`;
          return `<div class="checklist-item">
            <input type="checkbox" id="${id}" onchange="updateObProgress(${data.total_items})"/>
            <label for="${id}">${item}</label>
          </div>`;
        }).join('')}
      </div>`).join('');
    updateObProgress(data.total_items);
  } catch(e) { toast('Error generando checklist','error'); }
}

function updateObProgress(total) {
  const all = document.querySelectorAll('#ob-sections input[type=checkbox]');
  const chk = document.querySelectorAll('#ob-sections input[type=checkbox]:checked');
  if (!all.length) return;
  const pct = Math.round(chk.length/all.length*100);
  $('ob-prog-fill').style.width = pct+'%';
  $('ob-prog-pct').textContent = pct+'%';
  $('ob-prog-label').textContent = `${chk.length} de ${all.length} completados`;
  $('ob-prog-fill').style.background = pct===100?'var(--green)':pct>50?'var(--accent)':'var(--yellow)';
}

