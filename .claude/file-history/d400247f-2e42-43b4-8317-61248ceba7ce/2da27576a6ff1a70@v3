<script>
// ══════════════════════════════════════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════════════════════════════════════
const S = {
  peopleData: [],
  currentView: 'overview',
  currentTaskTab: 'tk-pendientes',
};

// ══════════════════════════════════════════════════════════════════════════════
// TOAST
// ══════════════════════════════════════════════════════════════════════════════
function toast(msg, type='info') {
  const icons = {success:'✅',error:'❌',info:'ℹ️',warning:'⚠️'};
  const el = document.createElement('div');
  el.className = `toast toast-${type}`;
  el.innerHTML = `<span>${icons[type]||'ℹ️'}</span><span>${msg}</span>`;
  document.getElementById('toasts').appendChild(el);
  setTimeout(() => {
    el.classList.add('toast-out');
    setTimeout(() => el.remove(), 250);
  }, 3500);
}

// ══════════════════════════════════════════════════════════════════════════════
// NAVIGATION
// ══════════════════════════════════════════════════════════════════════════════
const viewTitles = {
  overview:'Dashboard',people:'Equipo',cumpleanos:'Cumpleaños',
  licencias:'Licencias','cx-audit':'Auditoría CX','cx-upload':'Importar CSV',
  knowledge:'Conocimiento',tasks:'Tareas',finance:'Tesorería',onboarding:'Onboarding'
};

function goView(name) {
  // deactivate all
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  // activate
  const view = document.getElementById('v-'+name);
  if (view) view.classList.add('active');
  const navItem = document.querySelector(`[data-view="${name}"]`);
  if (navItem) navItem.classList.add('active');
  S.currentView = name;
  document.getElementById('tb-title').textContent = viewTitles[name] || name;
  document.getElementById('tb-sub').textContent = '';
}

document.querySelectorAll('.nav-item[data-view]').forEach(el => {
  el.addEventListener('click', () => {
    goView(el.dataset.view);
    const loaders = {
      overview:loadOverview, people:loadPeople, cumpleanos:loadCumpleanos,
      licencias:loadLicencias, tasks:loadTasks, finance:loadFinance,
      'cx-audit':loadCX, knowledge:()=>{},onboarding:()=>{},
      'cx-upload':()=>{}
    };
    if (loaders[el.dataset.view]) loaders[el.dataset.view]();
  });
});

// Task tabs
document.querySelectorAll('.tab[data-tab]').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    ['tk-pendientes','tk-vencidas','tk-completadas','tk-equipo'].forEach(id => {
      document.getElementById(id+'-panel').style.display = 'none';
    });
    document.getElementById(tab.dataset.tab+'-panel').style.display = 'block';
  });
});

function refreshCurrent() {
  const loaders = {
    overview:loadOverview, people:loadPeople, cumpleanos:loadCumpleanos,
    licencias:loadLicencias, tasks:loadTasks, finance:loadFinance, 'cx-audit':loadCX
  };
  if (loaders[S.currentView]) { loaders[S.currentView](); toast('Datos actualizados','success'); }
}

// ══════════════════════════════════════════════════════════════════════════════
// API
// ══════════════════════════════════════════════════════════════════════════════
async function api(url) {
  const r = await fetch(url);
  if (!r.ok) throw new Error(`HTTP ${r.status}`);
  return r.json();
}

// ══════════════════════════════════════════════════════════════════════════════
// UTILS
// ══════════════════════════════════════════════════════════════════════════════
const $ = id => document.getElementById(id);
const fmt = (n,d=0) => n != null ? parseFloat(n).toFixed(d) : '—';
const fmtARS = n => n != null ? '$'+parseFloat(n).toLocaleString('es-AR',{minimumFractionDigits:0,maximumFractionDigits:0}) : '—';
const initials = name => (name||'?').split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase();
const alertBadge = alerta => {
  const m = {
    deuda:`<span class="badge badge-red">Deuda</span>`,
    burnout_riesgo:`<span class="badge badge-yellow">Burnout</span>`,
    acumuladas_altas:`<span class="badge badge-yellow">Acum. altas</span>`,
    normal:`<span class="badge badge-green">Normal</span>`,
  };
  return m[alerta]||`<span class="badge badge-gray">${alerta||'—'}</span>`;
};

function setDot(id, type) {
  const el = document.getElementById(id);
  if (!el) return;
  el.className = `dot dot-${type} ${type==='green'?'pulse':''}`;
}

// Count-up animation
function countUp(el, target, suffix='') {
  const start = performance.now();
  const dur = 600;
  const from = 0;
  const run = ts => {
    const pct = Math.min((ts-start)/dur, 1);
    const ease = 1-Math.pow(1-pct,3);
    el.textContent = Math.round(from + (target-from)*ease) + suffix;
    if (pct < 1) requestAnimationFrame(run);
  };
  requestAnimationFrame(run);
}

// ══════════════════════════════════════════════════════════════════════════════
// OVERVIEW
// ══════════════════════════════════════════════════════════════════════════════
async function loadOverview() {
  try {
    const [ps, tasks, cumples, fin] = await Promise.all([
      api('/api/people/summary'),
      api('/api/tasks'),
      api('/api/people/cumpleanos?days=7'),
      api('/api/finance'),
    ]);

    // KPIs
    countUp($('ov-k1'), ps.total_colaboradores||0);
    countUp($('ov-k2'), ps.riesgo_burnout||0);
    countUp($('ov-k3'), ps.deudores_vacaciones||0);
    countUp($('ov-k4'), tasks.vencidas||0);

    // Badges
    const nb = $('nb-burnout');
    if (ps.riesgo_burnout > 0) { nb.textContent = ps.riesgo_burnout; nb.style.display=''; }
    const nbt = $('nb-tasks');
    if (tasks.vencidas > 0) { nbt.textContent = tasks.vencidas; nbt.style.display=''; }

    // Status dots
    setDot('dot-people', ps.deudores_vacaciones > 0 ? 'yellow' : 'green');
    setDot('dot-finance', fin.ok ? 'green' : 'yellow');
    $('st-people').textContent = ps.total_colaboradores + ' activos';
    $('st-finance').textContent = fin.ok ? 'Conectado' : 'Sin datos';

    $('ov-period').textContent = `Equipo de ${ps.total_colaboradores||0} colaboradores · ${new Date().toLocaleDateString('es-AR',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}`;

    // Alertas
    const alerts = ps.alertas || [];
    $('ov-alert-count').textContent = alerts.length;
    $('ov-alert-count').className = alerts.length > 0 ? 'badge badge-red' : 'badge badge-green';
    if (!alerts.length) {
      $('ov-alerts').innerHTML = `<div class="alert alert-success"><span class="alert-icon">✅</span><span>Sin alertas críticas activas</span></div>`;
    } else {
      $('ov-alerts').innerHTML = alerts.slice(0,5).map(a => {
        const cls = a.tipo==='danger'?'alert-danger':a.tipo==='warning'?'alert-warning':'alert-info';
        const icon = a.tipo==='danger'?'🔴':a.tipo==='warning'?'🟡':'🔵';
        return `<div class="alert ${cls}"><span class="alert-icon">${icon}</span><span>${a.mensaje}</span></div>`;
      }).join('');
    }

    // Finance summary
    if (fin.ok) {
      $('ov-finance').innerHTML = `
        <div class="finance-row">
          <span style="color:var(--t2)">Egresos</span>
          <span style="font-weight:600;color:var(--red)">${fmtARS(fin.total_egresos)}</span>
        </div>
        <div class="finance-row">
          <span style="color:var(--t2)">Ingresos</span>
          <span style="font-weight:600;color:var(--green)">${fmtARS(fin.total_ingresos)}</span>
        </div>
        <div class="finance-row">
          <span style="color:var(--t2)">Balance</span>
          <span style="font-weight:700;color:${fin.balance>=0?'var(--green)':'var(--red)'}">${fmtARS(fin.balance)}</span>
        </div>`;
    } else {
      $('ov-finance').innerHTML = `<div style="color:var(--t3);font-size:13px">${fin.message||'Sin datos de tesorería'}</div>`;
    }

    // Birthdays
    if (!cumples.length) {
      $('ov-birthdays').innerHTML = `<div style="color:var(--t3);font-size:13px">Sin cumpleaños esta semana</div>`;
    } else {
      $('ov-birthdays').innerHTML = cumples.map(c => `
        <div class="finance-row">
          <div style="display:flex;align-items:center;gap:8px">
            <div class="avatar">${initials(c.nombre)}</div>
            <div><div style="font-size:13px;font-weight:500">${c.nombre}</div><div style="font-size:11px;color:var(--t3)">${c.area||''}</div></div>
          </div>
          <span style="font-size:12px;color:${c.dias_para_cumple===0?'var(--yellow)':'var(--t2)'};font-weight:600">
            ${c.dias_para_cumple===0?'¡Hoy! 🎉':'en '+c.dias_para_cumple+'d'}
          </span>
        </div>`).join('');
    }

    // Tasks
    const pend = tasks.lista_pendientes||[];
    if (!pend.length) {
      $('ov-tasks-list').innerHTML = `<div class="alert alert-success"><span class="alert-icon">✅</span><span>Sin tareas pendientes</span></div>`;
    } else {
      $('ov-tasks-list').innerHTML = pend.slice(0,5).map(t => `
        <div class="finance-row">
          <div>
            <div style="font-size:13px;font-weight:500">${t.titulo}</div>
            <div style="font-size:11px;color:var(--t3)">${t.responsable} · ${t.fecha||'Sin fecha'}</div>
          </div>
        </div>`).join('');
    }

  } catch(e) {
    toast('Error cargando datos: '+e.message, 'error');
  }
}

