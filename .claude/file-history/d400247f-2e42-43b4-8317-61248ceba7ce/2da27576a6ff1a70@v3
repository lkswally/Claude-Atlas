// PEOPLE
// ══════════════════════════════════════════════════════════════════════════════
async function loadPeople() {
  try {
    S.peopleData = await api('/api/people/vacaciones');
    const total = S.peopleData.length;
    const normal = S.peopleData.filter(p=>p.alerta==='normal').length;
    const burnout = S.peopleData.filter(p=>['burnout_riesgo','acumuladas_altas'].includes(p.alerta)).length;
    const deuda = S.peopleData.filter(p=>p.alerta==='deuda').length;
    countUp($('pe-total'), total);
    countUp($('pe-normal'), normal);
    countUp($('pe-burnout'), burnout);
    countUp($('pe-deuda'), deuda);
    renderPeopleTable(S.peopleData);
    setDot('dot-people', deuda>0||burnout>3?'yellow':'green');
  } catch(e) { toast('Error cargando equipo','error'); }
}

function renderPeopleTable(data) {
  $('pe-tbody').innerHTML = !data.length
    ? `<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--t3)">Sin resultados</td></tr>`
    : data.map(p => {
        const saldo = parseFloat(p.vacaciones_saldo)||0;
        const saldoColor = saldo<0?'var(--red)':saldo>0?'var(--green)':'var(--t2)';
        return `<tr>
          <td><div style="display:flex;align-items:center;gap:9px">
            <div class="avatar" style="width:28px;height:28px;font-size:10px">${initials(p.nombre)}</div>
            <div style="font-size:13px;font-weight:500">${p.nombre}</div>
          </div></td>
          <td style="color:var(--t3);font-size:12px">${p.area||'—'}</td>
          <td style="text-align:right;font-family:monospace;color:${saldoColor};font-weight:600">${fmt(saldo,1)}</td>
          <td style="text-align:right;font-family:monospace;color:var(--t2)">${fmt(p.vacaciones_tomadas,0)}</td>
          <td style="text-align:right;font-family:monospace;color:var(--t3)">${p.vacaciones_dias_ley||14}</td>
          <td>${alertBadge(p.alerta)}</td>
        </tr>`;
      }).join('');
}

function filterPeople() {
  const q = $('pe-search').value.toLowerCase();
  const f = $('pe-filter').value;
  renderPeopleTable(S.peopleData.filter(p=>
    (!q || p.nombre.toLowerCase().includes(q) || (p.area||'').toLowerCase().includes(q)) &&
    (!f || p.alerta === f)
  ));
}

