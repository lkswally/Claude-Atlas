    $('tk-comp-list').innerHTML = (d.lista_completadas||[]).length
      ? d.lista_completadas.map(t=>`<div class="finance-row">
            <div style="font-size:13px;color:var(--t2)"><span style="color:var(--green)">✓</span> ${t.titulo}</div>
