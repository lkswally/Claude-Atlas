# ATLAS — Environment Variables
# Copy this file to .env.local and fill in what you have.
# All variables are optional — ATLAS degrades gracefully.
#
# .env.local is gitignored. Never commit real tokens.
# ============================================================

# --- GitHub ---
# Required for: git agent (push/PR), GitHub MCP
# Get at: https://github.com/settings/tokens
# Scopes: repo, workflow
GITHUB_TOKEN=

# --- Creative Pipeline (Phase 2B) ---
# Required for: AI image generation (brand-agent, image-agent, logo-agent)
# At least one of GEMINI_API_KEY or HF_TOKEN is needed for images.

# Google AI Studio — ~$0.02-0.04/image, requires billing enabled
# Get at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# HuggingFace — free tier available
# Get at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Replicate — ~$0.05/video, required for video generation
# Get at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Vercel ---
# Required for: deployer agent (Vercel MCP)
# Get at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# --- Feature Flags (escape hatches) ---
# Uncomment to disable specific ATLAS features.
# Useful for debugging or if a feature causes issues.

# Disable capability router (agents use raw MCP calls)
# ATLAS_CAPABILITIES_DISABLED=1

# Disable capability policy engine (all caps return ALLOW)
# ATLAS_CAPABILITY_POLICY_DISABLED=1

# Disable capability event logging
# ATLAS_CAPABILITY_EVENTS_DISABLED=1

# Disable hard rules hook
# ATLAS_HARD_RULES_DISABLED=1

# Disable skills registry
# ATLAS_SKILLS_REGISTRY_DISABLED=1
