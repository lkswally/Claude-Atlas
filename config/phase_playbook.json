      "hacer commit final",
      "desplegar a producción",
      "validar en prod"
    ]
  },
  "modificacion": {
    "name": "Modo Modificación (proyecto existente)",
    "allowed_commands": ["continue-phase", "run-task"],
    "boot_config": {
      "force_full_mode": false,
