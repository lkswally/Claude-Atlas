    "required_cajones": ["{proyecto}/tareas"],
    "produces_cajones": ["{proyecto}/css-foundation", "{proyecto}/design-system", "{proyecto}/security-spec"],
    "recommended_actions": [
      "crear CSS foundation (ux-architect)",
      "crear design system (ui-designer)",
      "definir security spec (security-engineer)"
    ]
  },
  "fase_2b_assets_creativos": {
    "name": "Assets Creativos",
    "allowed_commands": ["continue-phase"],
    "boot_config": {
      "force_full_mode": false,
      "allow_light_mode": true
    },
    "e2e_required": [],
    "required_cajones": ["{proyecto}/css-foundation", "{proyecto}/design-system"],
    "produces_cajones": ["{proyecto}/branding", "{proyecto}/creative-logos", "{proyecto}/creative-images", "{proyecto}/creative-video"],
