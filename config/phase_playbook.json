      },
      {
        "flow": "performance-benchmarker",
        "description": "Validar Core Web Vitals",
        "required_for": "certificar"
      },
      {
        "flow": "reality-checker",
        "description": "Validación final integrada",
        "required_for": "alcanzar estado CERTIFIED"
